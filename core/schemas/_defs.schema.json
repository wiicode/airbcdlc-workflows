{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbcdlc.dev/schema/_defs",
  "title": "Shared definitions",
  "description": "Common vocabulary for AI-RBC-DLC program records. Enums are the field guide's strict vocabulary; keeping them here is the single home for drift canaries.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Lower-kebab join key. Stable; names and tool views link to it, never merge onto it."
    },
    "harm_id": { "type": "string", "pattern": "^H[0-9]{1,2}$" },
    "tolerance_id": { "type": "string", "pattern": "^T-[0-9]{2,3}$" },
    "risk_id": { "type": "string", "pattern": "^R-[0-9]{3}$" },
    "branch_id": { "type": "string", "pattern": "^R-[0-9]{3}[a-z]$" },
    "decision_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-D-[0-9]{3}$" },
    "obligation_id": { "type": "string", "pattern": "^O-[0-9]{3}$" },
    "finding_id": { "type": "string", "pattern": "^F-[0-9]{4}$" },
    "scenario_id": { "type": "string", "pattern": "^S-[0-9]{4}$" },
    "monitor_id": { "type": "string", "pattern": "^M-[0-9]{4}$" },
    "control_code": { "type": "string", "pattern": "^[A-Z]{1,4}[0-9]{1,3}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },

    "likelihood": {
      "enum": ["precedent", "probable", "plausible", "remote"],
      "description": "From evidence, never adjectives (field guide §6.1)."
    },
    "severity": { "enum": ["catastrophic", "major", "moderate", "minor"] },
    "disposition": {
      "enum": ["avoid", "mitigate", "accept", "transfer"],
      "description": "The four terminal responses. Exactly one per branch — never a slash."
    },
    "consequence": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["reputational", "legal", "financial", "operational"] }
    },
    "register_status": {
      "enum": ["identified", "assessed", "decided", "treatment", "monitored"],
      "description": "Treatment is Mitigate-only. 'Decided' is the governed step; three of four responses close there."
    },
    "coverage": {
      "enum": ["planning", "active", "needs-change", "blocked", "parked"]
    },
    "intermediate_harm": {
      "enum": [
        "data-leaves-control",
        "credentials-secrets-compromised",
        "identity-acts-after-trust-ended",
        "unauthorized-undetected-change",
        "service-unavailable-degraded",
        "data-lost-corrupted",
        "financial-flows-manipulated",
        "third-party-compromise-reaches-us",
        "personal-data-processed-unlawfully"
      ],
      "description": "Controlled vocabulary (framework-supplied, extensible per profile, never free text). The tree resolves branches to a top-level harm through one of these."
    },
    "provenance": {
      "type": "object",
      "description": "On every record. No source, no fact.",
      "required": ["source", "added", "updated"],
      "properties": {
        "source": { "type": "string", "description": "Where this fact came from: a mirror path, a stage/intent, a person, a cited URL." },
        "added": { "$ref": "#/$defs/date" },
        "updated": { "$ref": "#/$defs/date" },
        "updated_by": { "type": "string", "description": "Agent slug or human identifier. Agents sign their own writes." },
        "validated": { "$ref": "#/$defs/date", "description": "Facts decay: 90-day review, quarterly re-validation." },
        "review_by": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "description": "Set only by a human action. The gate between proposed and done.",
      "required": ["by", "on"],
      "properties": {
        "by": { "type": "string", "description": "The human who authorized. Never an agent." },
        "on": { "$ref": "#/$defs/date" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
